# انسخ هذا الملف إلى .env وعدّل القيم — لا تضع أسرارًا حقيقية هنا أبدًا
APP_ENV=development

# مثال PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/study_ai
DATABASE_URL=sqlite:///./study_ai.db

# مفتاح طويل عشوائي (64+ حرف) — إلزامي تغييره في الإنتاج
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# كلمات مرور seed التطوير (placeholders فقط — القيم الحقيقية في .env المحلي)
DEV_ADMIN_PASSWORD=change-me
DEV_STUDENT_PASSWORD=change-me

# دومينات الواجهة مفصولة بفواصل — ممنوع "*" في الإنتاج
CORS_ORIGINS=http://localhost:3000
ENABLE_DOCS=true

LOGIN_RATE_LIMIT_PER_MINUTE=30
REGISTER_RATE_LIMIT_PER_MINUTE=10

# AI (اترك المفتاح فارغًا لاستخدام MockProvider)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=
AI_MAX_QUESTION_CHARS=2000
AI_RATE_LIMIT_PER_HOUR=30

# RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# الرفع
UPLOAD_MAX_MB=5

# التعلم
WEAKNESS_MIN_ATTEMPTS=2
WEAKNESS_THRESHOLD=60.0
RECURRING_MISTAKE_THRESHOLD=2
REVIEW_PLAN_MAX_ITEMS=6

# جدولة المراجعة (أيام)
REVIEW_INTERVAL_HIGH_DAYS=1
REVIEW_INTERVAL_MEDIUM_DAYS=2
REVIEW_INTERVAL_LOW_DAYS=4
REVIEW_INTERVAL_MASTERED_DAYS=7
REVIEW_MASTERED_MASTERY=90.0
REVIEW_MASTERED_CONFIDENCE=0.8
